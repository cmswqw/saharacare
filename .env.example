SUPABASE_SECRET_KEY=your-server-only-secret-key
MEDICAL_FILE_MAX_BYTES=10485760
MEDICAL_FILE_MAX_COUNT=6
CRON_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_DEMO_MODE=false
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
# Server-only: enable production specialty guidance only AFTER qualified clinical
# review of booking-safety.ts, instructions, clarification copy and EN/NE wording.
BOOKING_GUIDANCE_REVIEW_APPROVED=false
# Fictional samples; production also requires the explicit permission flag below.
HOSPITAL_PROMOTIONS_DEMO=false
# Explicit, reversible opt-in for fictional demonstrations on a deployed site.
HOSPITAL_PROMOTIONS_ALLOW_PRODUCTION_DEMO=false
# Optional HTTPS destination for the fictional sample artwork/button.
HOSPITAL_PROMOTIONS_DEMO_URL=https://example.invalid/saharacare-demo
